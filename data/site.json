  "sections": [
    {
      "id": "black-holes",
      "source": "bh",
      "title": "Black Hole Physics",
      "kicker": "Gravitational waves, tails, and singularities",
      "image": "media/images/side.gif",
      "summary": "Projects on binary black hole coalescence, radiative tails, black holes in loop quantum gravity, and Einstein@Home optimization."
    },
    {
      "id": "quantum-cosmology",
      "source": "qc",
      "title": "Quantum Cosmology",
      "kicker": "Discrete spacetime and the early universe",
      "image": "media/images/spinfoam.jpg",
      "summary": "Loop quantum cosmology, quantum space dynamics, black holes in loop quantum gravity, and cosmological natural selection."
    },
    {
      "id": "scientific-computation",
      "source": "sc",
      "title": "Scientific Computation",
      "kicker": "Alternative computing for numerical relativity",
      "image": "media/images/cellfft.png",
      "summary": "Use of PS3, IBM QS22 Cell blades, CUDA/OpenCL GPUs, and multicore CPUs for gravitational wave science."
    },
    {
      "id": "opencl",
      "source": "ocl",
      "title": "OpenCL Research",
      "kicker": "Portable many-core computing",
      "image": "media/images/FFT_khanna.jpeg",
      "summary": "OpenCL for high-resolution, long-duration black-hole binary inspiral computations and data analysis."
    },
    {
      "id": "gaming-tech",
      "source": "gametech",
      "title": "Gaming Technologies",
      "kicker": "Consumer hardware as scientific infrastructure",
      "image": "media/images/rackfront.jpg",
      "summary": "Exploration of gaming GPUs, fused processors, and next-generation consoles for numerical modeling and big-data analysis."
    },
    {
      "id": "ps3",
